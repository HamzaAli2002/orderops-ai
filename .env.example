# --- Database (MySQL) ---
DATABASE_URL=mysql+aiomysql://orderops:orderops@localhost:3306/orderops
ALEMBIC_DATABASE_URL=mysql+pymysql://orderops:orderops@localhost:3306/orderops

# --- App ---
ENVIRONMENT=development
APP_SECRET_KEY=change-me
# Base URL the FastAPI backend is reachable at - used to build the
# Accept/Reject links inside negotiation emails.
APP_BASE_URL=http://localhost:8000

# --- LLM Provider (negotiation agent) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Notifications (real SMTP - e.g. Gmail App Password, or any SMTP provider) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=orders@yourstore.com
SMTP_USE_TLS=true

# --- Seeding (seed_data.py only - not read by the app itself) ---
# Set this to YOUR real email so negotiation test emails actually land
# in your inbox. Every other seeded customer gets a placeholder email.
TEST_CUSTOMER_EMAIL=you@example.com

# --- Negotiation policy ---
NEGOTIATION_DISCOUNT_PCT=10
NEGOTIATION_RESPONSE_TIMEOUT_HOURS=24

# --- Fraud check ---
FRAUD_RISK_THRESHOLD=0.7
